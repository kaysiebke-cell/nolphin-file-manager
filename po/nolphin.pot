#. Translators: Time in 24h format
#. Translators: Time in 12h format
#: libnolphin-private/nolphin-file.c:5625
#: libnolphin-private/nolphin-file.c:5628
msgid "%H:%M"
msgstr ""

#. Translators: this is the word Yesterday followed by
#. * a time in 24h format. i.e. "Yesterday 23:04"
#. Translators: this is the word Yesterday followed by
#. * a time in 12h format. i.e. "Yesterday 9:04 PM"
#: libnolphin-private/nolphin-file.c:5641
#: libnolphin-private/nolphin-file.c:5646
#, no-c-format
msgid "Gestern %H:%M"
msgstr ""

#: libnolphin-private/nolphin-file.c:5654
#, no-c-format
msgid "%A"
msgstr ""

#. Translators: this is the name of the week day followed by
#. * a time in 24h format. i.e. "Monday 23:04"
#. Translators: this is the week day name followed by
#. * a time in 12h format. i.e. "Monday 9:04 PM"
#: libnolphin-private/nolphin-file.c:5660
#: libnolphin-private/nolphin-file.c:5665
#, no-c-format
msgid "%A %H:%M"
msgstr ""

#. Translators: this is the day of the month followed
#. * by the abbreviated month name i.e. "3 February"
#: libnolphin-private/nolphin-file.c:5673
#, no-c-format
msgid "%e. %B"
msgstr ""

#. Translators: this is the day of the month followed
#. * by the abbreviated month name followed by a time in
#. * 24h format i.e. "3 February 23:04"
#: libnolphin-private/nolphin-file.c:5680
#, no-c-format
msgid "%e. %B, %H:%M"
msgstr ""

#. Translators: this is the day of the month followed
#. * by the abbreviated month name followed by a time in
#. * 12h format i.e. "3 February 9:04"
#: libnolphin-private/nolphin-file.c:5686
#, no-c-format
msgid "%e. %B %H:%M"
msgstr ""

#. Translators: this is the day of the month followed by the abbreviated
#. * month name followed by the year i.e. "3 Feb 2015"
#: libnolphin-private/nolphin-file.c:5694
#, no-c-format
msgid "%e. %b. %Y"
msgstr ""

#. Translators: this is the day number followed
#. * by the abbreviated month name followed by the year followed
#. * by a time in 24h format i.e. "3 Feb 2015 23:04"
#: libnolphin-private/nolphin-file.c:5701
#, no-c-format
msgid "%e. %b. %Y, %H:%M"
msgstr ""

#. Translators: this is the day number followed
#. * by the abbreviated month name followed by the year followed
#. * by a time in 12h format i.e. "3 Feb 2015 9:04 PM"
#: libnolphin-private/nolphin-file.c:5707
#, no-c-format
msgid "%e. %b. %Y %H:%M"
