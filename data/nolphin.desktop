[Desktop Entry]
Name=Nolphin
Name[de]=Nolphin
Comment=Access and organize files
Comment[de]=Dateien aufrufen und organisieren
Exec=nolphin %U
Icon=org.nolphin.FileManager
# Translators: these are keywords of the file manager
Keywords=folders;filesystem;explorer;files;
Keywords[de]=Ordner;Dateisystem;Explorer;Dateien;Dateimanager;
Terminal=false
Type=Application
StartupNotify=true
Categories=Utility;FileTools;FileManager;GTK;
MimeType=inode/directory;application/x-gnome-saved-search;
Actions=open-home;open-computer;open-trash;

[Desktop Action open-home]
Name=Home
Name[de]=Persönlicher Ordner
Exec=nolphin %U

[Desktop Action open-computer]
Name=Computer
Name[de]=Rechner
Exec=nolphin computer:///

[Desktop Action open-trash]
Name=Trash
Name[de]=Papierkorb
Exec=nolphin trash:///
