<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
   <mime-type type="application/nolphin-action">
     <_comment>Nolphin action definition</_comment>
     <generic-icon name="text-x-generic"/>
     <sub-class-of type="text/plain"/>
     <glob pattern="*.nolphin_action"/>
   </mime-type>
   <mime-type type="application/nolphin-search-helper">
     <_comment>Nolphin search-helper definition</_comment>
     <generic-icon name="text-x-generic"/>
     <sub-class-of type="text/plain"/>
     <glob pattern="*.nolphin_search_helper"/>
   </mime-type>
</mime-info>
